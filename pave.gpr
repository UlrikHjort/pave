with "gtkada";

project Pave is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";      --  a fresh clone has no obj/ yet
   for Exec_Dir use ".";
   for Main use ("pave.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2012", "-gnatwa", "-gnatwK");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-lm", "-lpulse-simple", "-lpulse");
   end Linker;
end Pave;
